<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyProjectBase.App"
             xmlns:local="using:MyProjectBase"
             RequestedThemeVariant="Default">
             <!-- Le theme "Default" suit le theme systeme. "Dark" et "Light" restent disponibles. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MyProjectBase/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
