<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyProjectBase.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="620"
             x:Class="MyProjectBase.Views.CollectionView"
             x:DataType="vm:CollectionViewModel"
             x:Name="Collection">

    <Design.DataContext>
        <vm:CollectionViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="12" Margin="16">
        <!-- En-tete de la page collection : affiche le message du ViewModel et la barre de chargement. -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="panel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Collection" Classes="title" />
                    <TextBlock Text="{Binding Message}" Classes="status" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Width="160"
                             Height="4"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="12" Spacing="10">
                    <!-- Chaque bouton appelle une commande de CollectionViewModel pour manipuler la collection. -->
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <!-- LoadJsonCommand recupere le JSON distant de l'utilisateur actif. -->
                        <Button Content="Load JSON" Classes="primary" Command="{Binding LoadJsonCommand}" />
                        <!-- AddShoeCommand ouvre le panneau de creation a droite. -->
                        <Button Content="Add" Command="{Binding AddShoeCommand}" />
                        <!-- OpenEditPanelCommand ouvre le formulaire d'edition pour SelectedShoe. -->
                        <Button Content="Edit" Command="{Binding OpenEditPanelCommand}" />
                        <!-- DeleteSelectedShoeCommand supprime la sneaker selectionnee apres confirmation. -->
                        <Button Content="Delete" Classes="danger" Command="{Binding DeleteSelectedShoeCommand}" />
                        <!-- ExportCsvCommand exporte les colonnes cochees. -->
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                        <!-- ImportCsvCommand ajoute les lignes du CSV a la collection actuelle. -->
                        <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" />
                    </WrapPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Visible fields / CSV export" Classes="muted" />
                        <!-- Ces cases servent aussi au choix des colonnes exportees en CSV. -->
                        <WrapPanel ItemSpacing="12" LineSpacing="6">
                            <CheckBox Content="ID (CSV)" IsChecked="{Binding ExportId}" />
                            <CheckBox Content="Brand" IsChecked="{Binding ExportBrand}" />
                            <CheckBox Content="Model" IsChecked="{Binding ExportModel}" />
                            <CheckBox Content="Group" IsChecked="{Binding ExportGroup}" />
                            <CheckBox Content="Stock" IsChecked="{Binding ExportStock}" />
                            <CheckBox Content="Price" IsChecked="{Binding ExportPrice}" />
                            <CheckBox Content="Image" IsChecked="{Binding ExportImagePath}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Stock by group" Classes="muted" />
                        <!-- ItemsControl construit une petite visualisation a partir de StockByGroup. -->
                        <ItemsControl ItemsSource="{Binding StockByGroup}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="8" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupStockSummary">
                                    <Border Background="Black"
                                            BorderBrush="#D2B48C"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="8,5"
                                            Width="170">
                                        <Grid RowDefinitions="Auto,4" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Group}"
                                                       Classes="muted"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Stock}"
                                                       Classes="muted"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right" />
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Width="{Binding BarWidth}"
                                                    MaxWidth="150"
                                                    Height="4"
                                                    HorizontalAlignment="Left"
                                                    Background="SkyBlue"
                                                    CornerRadius="2" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Liste principale : MyObservableShoes est une ObservableCollection, donc l'UI suit les ajouts/suppressions. -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding MyObservableShoes}"
                         SelectedItem="{Binding SelectedShoe}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <!-- Template d'une sneaker dans la liste. Les bindings lisent les proprietes de Shoe. -->
                        <DataTemplate>
                            <Border Background="Black"
                                    BorderBrush="#D2B48C"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Padding="18"
                                    Margin="12,8"
                                    HorizontalAlignment="Stretch">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,180" RowSpacing="16" ColumnSpacing="18">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Background="Black"
                                            MinHeight="280"
                                            MaxHeight="320"
                                            IsVisible="{Binding DataContext.ExportImagePath, ElementName=Collection}">
                                        <Image Width="520"
                                           Height="300"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{Binding Picture}" />
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                MinWidth="320">
                                        <TextBlock Text="{Binding Brand}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding DataContext.ExportBrand, ElementName=Collection}" />
                                        <TextBlock Text="{Binding Model}"
                                                   Classes="muted"
                                                   FontSize="20"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   IsVisible="{Binding DataContext.ExportModel, ElementName=Collection}" />
                                        <TextBlock Text="{Binding Group, StringFormat=Group : {0}}"
                                                   Classes="muted"
                                                   FontSize="13"
                                                   IsVisible="{Binding DataContext.ExportGroup, ElementName=Collection}" />
                                        <TextBlock Text="{Binding Stock, StringFormat=Stock : {0}}"
                                                   Classes="muted"
                                                   FontSize="13"
                                                   IsVisible="{Binding DataContext.ExportStock, ElementName=Collection}" />
                                        <TextBlock Text="{Binding Price, StringFormat=Price : {0:0.00} €}"
                                                   Classes="muted"
                                                   FontSize="13"
                                                   IsVisible="{Binding DataContext.ExportPrice, ElementName=Collection}" />
                                    </StackPanel>

                                    <!-- FromParentCommand vient de MainWindowViewModel et change CurrentPage vers CollectionDetailsView. -->
                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="Details"
                                            Classes="primary"
                                            Command="{Binding DataContext.FromParentCommand, ElementName=Collection}"
                                            CommandParameter="{Binding Id}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            MinWidth="140" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Classes="panel"
                Width="360"
                IsVisible="{Binding IsAddPanelVisible}">
            <!-- Panneau d'ajout : visible quand AddShoeCommand met IsAddPanelVisible a true. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <TextBlock Text="Add a sneaker" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text="Identifier" Classes="muted" />
                    <TextBox Text="{Binding NewId, Mode=TwoWay}" Watermark="Scan code or leave empty" />
                    <TextBlock Text="Brand" Classes="muted" />
                    <TextBox Text="{Binding NewBrand, Mode=TwoWay}" Watermark="Nike" />
                    <TextBlock Text="Model" Classes="muted" />
                    <TextBox Text="{Binding NewModel, Mode=TwoWay}" Watermark="Air Max" />
                    <TextBlock Text="Group" Classes="muted" />
                    <TextBox Text="{Binding NewGroup, Mode=TwoWay}" Watermark="Sneakers" />
                    <TextBlock Text="Stock" Classes="muted" />
                    <NumericUpDown Value="{Binding NewStock, Mode=TwoWay}" Minimum="0" />
                    <TextBlock Text="Price (€)" Classes="muted" />
                    <NumericUpDown Value="{Binding NewPrice, Mode=TwoWay}" Minimum="0" FormatString="F2" />
                    <TextBlock Text="Image" Classes="muted" />
                    <ComboBox ItemsSource="{Binding AvailableImages}"
                              SelectedItem="{Binding NewImagePath, Mode=TwoWay}"
                              MaxDropDownHeight="180" />
                    <!-- ConfirmAddCommand valide, ajoute au repository, puis sauvegarde le JSON distant. -->
                    <Button Content="Save" Classes="primary" Command="{Binding ConfirmAddCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelAddCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Classes="panel"
                Width="360"
                IsVisible="{Binding IsEditPanelVisible}">
            <!-- Panneau d'edition : visible quand une sneaker est selectionnee puis Edit clique. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <TextBlock Text="Edit sneaker" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text="Brand" Classes="muted" />
                    <TextBox Text="{Binding EditBrand, Mode=TwoWay}" />
                    <TextBlock Text="Model" Classes="muted" />
                    <TextBox Text="{Binding EditModel, Mode=TwoWay}" />
                    <TextBlock Text="Group" Classes="muted" />
                    <TextBox Text="{Binding EditGroup, Mode=TwoWay}" />
                    <TextBlock Text="Stock" Classes="muted" />
                    <NumericUpDown Value="{Binding EditStock, Mode=TwoWay}" Minimum="0" />
                    <TextBlock Text="Price (€)" Classes="muted" />
                    <NumericUpDown Value="{Binding EditPrice, Mode=TwoWay}" Minimum="0" FormatString="F2" />
                    <TextBlock Text="Image" Classes="muted" />
                    <ComboBox ItemsSource="{Binding AvailableImages}"
                              SelectedItem="{Binding EditImagePath, Mode=TwoWay}"
                              MaxDropDownHeight="180" />
                    <!-- ConfirmEditCommand garde le meme ID, modifie les champs, puis sauvegarde le JSON distant. -->
                    <Button Content="Save" Classes="primary" Command="{Binding ConfirmEditCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
