<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyProjectBase.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="620"
             x:Class="MyProjectBase.Views.CollectionView"
             x:DataType="vm:CollectionViewModel"
             x:Name="Collection">

    <Design.DataContext>
        <vm:CollectionViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="12" Margin="16">
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="panel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Collection" Classes="title" />
                    <TextBlock Text="{Binding Message}" Classes="status" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Width="160"
                             Height="4"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <WrapPanel Grid.Row="0" Margin="12" ItemSpacing="8" LineSpacing="8">
                    <Button Content="Load JSON" Classes="primary" Command="{Binding LoadJsonCommand}" />
                    <Button Content="Add" Command="{Binding AddShoeCommand}" />
                    <Button Content="Edit" Command="{Binding OpenEditPanelCommand}" />
                    <Button Content="Delete" Classes="danger" Command="{Binding DeleteSelectedShoeCommand}" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                    <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" />
                </WrapPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding MyObservableShoes}"
                         SelectedItem="{Binding SelectedShoe}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Black"
                                    BorderBrush="#D2B48C"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Padding="18"
                                    Margin="12,8"
                                    HorizontalAlignment="Stretch">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,180" RowSpacing="16" ColumnSpacing="18">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Background="Black"
                                            MinHeight="280"
                                            MaxHeight="320">
                                        <Image Width="520"
                                           Height="300"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{Binding Picture}" />
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                MinWidth="320">
                                        <TextBlock Text="{Binding Brand}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Model}"
                                                   Classes="muted"
                                                   FontSize="20"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2" />
                                        <TextBlock Text="{Binding Id, StringFormat=ID : {0}}"
                                                   Classes="muted"
                                                   FontSize="13"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="Details"
                                            Classes="primary"
                                            Command="{Binding DataContext.FromParentCommand, ElementName=Collection}"
                                            CommandParameter="{Binding Id}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            MinWidth="140" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Classes="panel"
                Width="320"
                IsVisible="{Binding IsAddPanelVisible}">
            <StackPanel Spacing="10">
                <TextBlock Text="Add a sneaker" FontWeight="Bold" FontSize="18" />
                <TextBlock Text="Brand" Classes="muted" />
                <TextBox Text="{Binding NewBrand, Mode=TwoWay}" Watermark="Nike" />
                <TextBlock Text="Model" Classes="muted" />
                <TextBox Text="{Binding NewModel, Mode=TwoWay}" Watermark="Air Max" />
                <TextBlock Text="Image" Classes="muted" />
                <ComboBox ItemsSource="{Binding AvailableImages}"
                          SelectedItem="{Binding NewImagePath, Mode=TwoWay}"
                          MaxDropDownHeight="220" />
                <Button Content="Save" Classes="primary" Command="{Binding ConfirmAddCommand}" />
                <Button Content="Cancel" Command="{Binding CancelAddCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Classes="panel"
                Width="320"
                IsVisible="{Binding IsEditPanelVisible}">
            <StackPanel Spacing="10">
                <TextBlock Text="Edit sneaker" FontWeight="Bold" FontSize="18" />
                <TextBlock Text="Brand" Classes="muted" />
                <TextBox Text="{Binding EditBrand, Mode=TwoWay}" />
                <TextBlock Text="Model" Classes="muted" />
                <TextBox Text="{Binding EditModel, Mode=TwoWay}" />
                <TextBlock Text="Image" Classes="muted" />
                <ComboBox ItemsSource="{Binding AvailableImages}"
                          SelectedItem="{Binding EditImagePath, Mode=TwoWay}"
                          MaxDropDownHeight="220" />
                <Button Content="Save" Classes="primary" Command="{Binding ConfirmEditCommand}" />
                <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
