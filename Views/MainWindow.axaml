<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyProjectBase.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="860"
        x:Class="MyProjectBase.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Sneaker Collection"
        MinWidth="980"
        MinHeight="680">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="14">
        <!-- Bandeau du haut : titre, etat global, connexion scanner. -->
        <Border Grid.Row="0" Classes="panel">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="14" ColumnSpacing="18">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="Sneaker Collection | Interface version 2.0 | Akim Belkouaci / Mohamed Atouli"
                               Classes="title"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Avalonia • .NET 10 • JSON • CSV • Scanner • Accounts"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <!-- Ce bouton appelle ConnectScannerCommand dans MainWindowViewModel pour relancer la detection automatique. -->
                    <Button Content="Reconnect scanner"
                            Classes="primary"
                            Command="{Binding ConnectScannerCommand}" />
                    <!-- Ce bouton appelle DisconnectScannerCommand pour fermer proprement le port serie. -->
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectScannerCommand}" />
                </StackPanel>

                <!-- StatusMessage et QrCode viennent du ViewModel et changent automatiquement par data binding. -->
                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{Binding StatusMessage}" Classes="status" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding QrCode, StringFormat=Last scan: {0}}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" MinWidth="280">
                        <TextBlock Text="{Binding IsScannerConnected, StringFormat=Scanner connected: {0}}"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold" />
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}"
                                     Height="4" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="14">
            <!-- Menu lateral : connexion, creation de compte, navigation. -->
            <Border Grid.Column="0" Classes="panel">
                <ScrollViewer>
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="User session" FontWeight="Bold" />
                            <!-- Visible seulement apres connexion grace a IsAuthenticated. -->
                            <TextBlock Text="{Binding CurrentUser.DisplayName, StringFormat=Logged in: {0}}"
                                       IsVisible="{Binding IsAuthenticated}"
                                       Classes="status" />
                            <Button Content="Logout"
                                    IsVisible="{Binding IsAuthenticated}"
                                    Command="{Binding LogoutCommand}" />
                            <!-- Bouton admin : il existe dans le XAML, mais il n'est visible que si IsAdmin est true. -->
                            <Button Content="Administration"
                                    Classes="primary"
                                    IsVisible="{Binding IsAdmin}"
                                    Command="{Binding GoToAdminCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding !IsAuthenticated}">
                            <TextBlock Text="Login" FontWeight="Bold" />
                            <!-- Les TextBox remplissent LoginEmail et LoginPassword dans MainWindowViewModel. -->
                            <TextBox Watermark="Email" Text="{Binding LoginEmail, Mode=TwoWay}" />
                            <TextBox Watermark="Password" PasswordChar="*" Text="{Binding LoginPassword, Mode=TwoWay}" />
                            <!-- Ce bouton appelle LoginCommand, genere par [RelayCommand] sur LoginAsync. -->
                            <Button Content="Login" Classes="primary" Command="{Binding LoginCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding !IsAuthenticated}">
                            <TextBlock Text="Create account" FontWeight="Bold" />
                            <!-- Formulaire d'inscription : les valeurs sont envoyees a RegisterCommand. -->
                            <TextBox Watermark="Name" Text="{Binding RegisterDisplayName, Mode=TwoWay}" />
                            <TextBox Watermark="Email" Text="{Binding RegisterEmail, Mode=TwoWay}" />
                            <TextBox Watermark="Password" PasswordChar="*" Text="{Binding RegisterPassword, Mode=TwoWay}" />
                            <Button Content="Create account" Command="{Binding RegisterCommand}" />
                        </StackPanel>

                        <Border Height="1" Background="#D2B48C" />

                        <StackPanel Spacing="8">
                            <!-- Retour a la page collection principale via BackToMainCommand. -->
                            <Button Content="Collection" Classes="primary" Command="{Binding BackToMainCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="0">
                <!-- Zone centrale : affiche la page courante, par exemple CollectionView ou AdminUsersView. -->
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
