<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyProjectBase.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="800"
        x:Class="MyProjectBase.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="MyProjectBase"
        Background="Black">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#D2B48C"
                BorderThickness="2"
                CornerRadius="3"
                Padding="14"
                Margin="10,10,10,0">

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="12"
                  ColumnSpacing="20">

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="Sneaker Collection | Interface version 1.0 | Akim Belkouaci / Mohamed Atouli"
                           Foreground="SkyBlue"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Left">
                    <Button Background="SkyBlue"
                            Foreground="Black"
                            Command="{Binding ConnectScannerCommand}">
                        Connect scanner
                    </Button>

                    <Button Background="#D2B48C"
                            Foreground="Black"
                            Command="{Binding DisconnectScannerCommand}">
                        Disconnect scanner
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="4"
                            MaxWidth="420">
                    <TextBlock Text="{Binding IsScannerConnected, StringFormat=Scanner connected: {0}}"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding QrCode, StringFormat=Last scan: {0}}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               TextAlignment="Right"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="SkyBlue"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="180,*" Margin="10">
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderBrush="#D2B48C"
                    BorderThickness="2"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,10,10,10">
                <StackPanel HorizontalAlignment="Center">
                    <Button Background="SkyBlue"
                            Foreground="Black"
                            Command="{Binding BackToMainCommand}"
                            HorizontalAlignment="Center">
                        Main
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1E1E1E"
                    BorderBrush="#D2B48C"
                    BorderThickness="2"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,10,0,10">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>