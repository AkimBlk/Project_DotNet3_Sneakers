<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyProjectBase.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="620"
             x:Class="MyProjectBase.Views.CollectionDetailsView"
             x:DataType="vm:CollectionDetailsViewModel">

    <Design.DataContext>
        <vm:CollectionDetailsViewModel />
    </Design.DataContext>

    <Grid Margin="24" ColumnDefinitions="*,320" ColumnSpacing="24">
        <Border Grid.Column="0" Classes="panel">
            <Image Source="{Binding MyShoe.Picture}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   MinHeight="360" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="18" VerticalAlignment="Center">
            <TextBlock Text="Sneaker details" Classes="title" />
            <StackPanel Spacing="6">
                <TextBlock Text="Brand" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Brand}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Model" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Model}" FontSize="22" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Identifier" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Id}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
