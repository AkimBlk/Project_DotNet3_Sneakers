<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyProjectBase.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="620"
             x:Class="MyProjectBase.Views.CollectionDetailsView"
             x:DataType="vm:CollectionDetailsViewModel">

    <Design.DataContext>
        <vm:CollectionDetailsViewModel />
    </Design.DataContext>

    <Grid Margin="24" RowDefinitions="Auto,*" ColumnDefinitions="*,320" RowSpacing="16" ColumnSpacing="24">
        <!-- Bouton retour : BackCommand est fourni par MainWindowViewModel pour revenir a CollectionView. -->
        <Button Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="Back to collection"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                Classes="primary" />

        <!-- Image de la sneaker selectionnee. Elle vient de MyShoe.Picture et n'est pas sauvegardee dans le JSON. -->
        <Border Grid.Row="1" Grid.Column="0" Classes="panel">
            <Image Source="{Binding MyShoe.Picture}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   MinHeight="360" />
        </Border>

        <!-- Details en lecture seule : cette page sert a presenter un objet existant. -->
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="18" VerticalAlignment="Center">
            <TextBlock Text="Sneaker details" Classes="title" />
            <StackPanel Spacing="6">
                <TextBlock Text="Brand" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Brand}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Model" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Model}" FontSize="22" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Identifier" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Id}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Group" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Group}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Stock / price" Classes="muted" />
                <TextBlock Text="{Binding MyShoe.Stock, StringFormat={}{0} items}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MyShoe.Price, StringFormat={}{0:0.00} €}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
