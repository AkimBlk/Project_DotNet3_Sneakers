<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyProjectBase.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="620"
             x:Class="MyProjectBase.Views.ScannerView"
             x:DataType="vm:ScannerViewModel">

    <Design.DataContext>
        <vm:ScannerViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="16">
        <!-- Page scanner separee comme dans le projet de base : ici elle sert a suivre l'etat du lecteur. -->
        <Border Grid.Row="0" Classes="panel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Scanner console" Classes="title" />
                    <TextBlock Text="{Binding Status}" Classes="status" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IsConnected, StringFormat=Scanner connected: {0}}" Classes="muted" />
                </StackPanel>

                <!-- Ces boutons appellent ScannerViewModel ; aucun port n'est affiche a l'utilisateur. -->
                <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                    <Button Content="Start detection"
                            Classes="primary"
                            Command="{Binding StartDetectionCommand}" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}" />
                    <Button Content="Clear"
                            Command="{Binding ClearHistoryCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="12">
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Text="Scan history" FontWeight="Bold" FontSize="18" />

                    <!-- Historique des scans recus depuis ScannerManager.CodeReceived. -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Scans}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="listItem">
                                    <SelectableTextBlock Text="{Binding .}" FontFamily="Consolas" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Last scan" FontWeight="Bold" FontSize="18" />
                    <SelectableTextBlock Text="{Binding LastScan}"
                                         FontSize="18"
                                         TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
